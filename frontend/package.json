
{
  "name": "spacedock-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "SpaceDock Frontend with Tailwind CSS v4",
  "scripts": {
    "dev": "npm run watch",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./styles/input.css -o ./build/css/output.css --minify",
    "watch": "tailwindcss -i ./styles/input.css -o ./build/css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
